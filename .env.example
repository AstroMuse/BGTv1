# SPAR configuration template. Copy to `.env` and fill in your own keys:
#     cp .env.example .env
# `.env` is git-ignored and loaded automatically by global_config.py (python-dotenv).
# Leave a key blank to disable the feature that needs it.

# === LLM backend (at least one REQUIRED) ====================================
# Relevance scoring + query expansion call an LLM on EVERY document.
# DeepSeek — required for the default LLM path (query expansion / relevance
# scoring / Agent C / Agent B verification). Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Optional dedicated DeepSeek key for Agent B's thinking-mode recall
# (bills on its own account). Can reuse DEEPSEEK_API_KEY's value.
DEEPSEEK_API_KEY_AGENT_B=

# Aliyun DashScope — only needed if you select the Qwen3-32B model.
# https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=

# Which model to use. Any key from MODEL_CONFIGS in local_request_v2.py:
# DeepSeek-V4 (default) | DeepSeek-V4-Pro | Qwen3-32B | Qwen3-8B/14B/32B (local vLLM)
SPAR_MODEL=DeepSeek-V4

# === Search sources =========================================================
# Google Serper — needed for the arXiv search route + Agent B existence check.
# Free tier (2500 queries) at https://serper.dev
GOOGLE_SERPER_KEY=

# Semantic Scholar — reference fallback (Phase 2) + bulk Datasets API
# (build_citation_store.py). Works without a key, but one raises the rate limit.
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Optional: contact email for OpenAlex's faster "polite pool".
OPENALEX_MAILTO=

# === Network / proxy (optional) =============================================
# Under WSL2 the Windows-host gateway is auto-detected on :PROXY_PORT.
# Set HTTP_PROXY/HTTPS_PROXY to override, or leave blank if you don't use a proxy.
PROXY_PORT=7890
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# === Optional feature toggles (all default OFF/safe) ========================
# Most are also settable per-run via run_spr_agent.py CLI flags — see README.
# SPAR_DO_REFERENCE=on        # Phase 2 reference expansion (--reference)
# SPAR_DO_PHASE3=on           # Phase 3 deeper BFS (--phase3)
# SPAR_REF_API=openalex       # openalex | s2 | local        (--ref-api)
# SPAR_REF_PRUNE=freq         # freq | citation              (--ref-prune)
# SPAR_RERANK=on              # BGE cross-encoder rerank      (--rerank; needs peft)
# SPAR_BGE_PREFILTER=on       # BGE coarse-filter -> LLM cascade (--bge-prefilter)
# SPAR_SCORING_PROMPT=intent  # intent | rubric              (--score-prompt)
# SPAR_AGENT_B=on             # LLM memory-recall agent
# SPAR_AGENT_C=on             # intent-constraint decomposition agent
# BGE_BASE_MODEL_PATH=./bge/bge-reranker-v2-m3
# BGE_LORA_PATH=./bge/output/lora-natural/best_model

# === AstaBench bridge (astabench_bridge/run_paperfinding.sh) =================
# Grader routed through OpenRouter; the SPAR pipeline still uses DeepSeek.
# OPENAI_API_KEY=             # OpenRouter key (sk-or-v1-...)
# HF_ACCESS_TOKEN=            # HuggingFace read token for the gated dataset
